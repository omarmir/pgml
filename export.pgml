      Table extensions.agency_enablement {
        id bigint [pk, not null, default: nextval('extensions.agency_enablement_id_seq')]
        extension_key varchar(120) [not null]
        agency_id bigint [not null, ref: > public.agency_profile.id, delete: restrict]
        enabled boolean [not null, default: false]
        _deleted boolean [not null, default: false]

        Index ext_idx_agency_enablement_extension_agency (extension_key, agency_id) [type: btree]
      }

      Table extensions.kv_entry {
        id bigint [pk, not null, default: nextval('extensions.kv_entry_id_seq')]
        extension_key varchar(120) [not null]
        owner_type varchar(80) [not null]
        owner_id varchar(120) [not null]
        config_key varchar(160) [not null]
        value jsonb [not null, default: '{}'::jsonb]
        _deleted boolean [not null, default: false]

        Index ext_idx_kv_entry_active_key (extension_key, owner_type, owner_id, config_key) [type: btree]
      }

      Table extensions.stream_configuration {
        id bigint [pk, not null, default: nextval('extensions.stream_configuration_id_seq')]
        extension_key varchar(120) [not null]
        stream_id bigint [not null, ref: > public.transfer_payment_stream.id, delete: restrict]
        enabled boolean [not null, default: false]
        config jsonb [not null, default: '{}'::jsonb]
        _deleted boolean [not null, default: false]

        Index ext_idx_stream_configuration_extension_stream (extension_key, stream_id) [type: btree]
      }

