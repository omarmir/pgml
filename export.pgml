      Table public.common_additional_reviewers in Common {
        id bigint [pk, not null, default: nextval('public.Common_Additional_Reviewers_id_seq')]
        egcs_cn_entitytype public.entity_type [not null]
        egcs_cn_entityid bigint [not null]
        egcs_cn_comments text
        egcs_cn_user bigint [not null, ref: > public.common_user.id, delete: restrict]
        egcs_cn_completedat timestamptz
        _deleted boolean [not null, default: false]

        Constraint cn_chk_additionalreviewersentitytype: egcs_cn_entitytype <> ALL (ARRAY['fundingopportunity'::public."Entity_Type", 'fundingcaseintake'::public."Entity_Type", 'fundingcaseagreement'::public."Entity_Type", 'applicantrecipient'::public."Entity_Type", 'transferpaymentstream'::public."Entity_Type"])
        Constraint cn_ref_additionalreviewersentityidentitytype: foreign key (egcs_cn_entityid, egcs_cn_entitytype) references public.Common_Entity (id, egcs_cn_entitytype)
        Index cn_idx_additionalreviewersentitytypeentityid (egcs_cn_entitytype, egcs_cn_entityid) [type: btree]
      }

      Table public.common_address in Common {
        id bigint [pk, not null, default: nextval('public.Common_Address_id_seq')]
        egcs_cn_federalridingid integer [not null]
        egcs_cn_addresscity varchar(255) [not null]
        egcs_cn_addresscountry public.countries [not null]
        egcs_cn_addresssubdivision varchar(255) [not null]
        egcs_cn_gc_addressid bigint
        egcs_cn_latitude numeric(10, 7)
        egcs_cn_longitude numeric(10, 7)
        egcs_cn_mainphone bigint [not null]
        egcs_cn_mainphoneextension smallint
