    Table public.common_attachment in Common {
      id bigserial [pk, not null] // System ID
      egcs_cn_attachmenttype bigint [not null]
      egcs_cn_name_en varchar(255) [not null]
      egcs_cn_name_fr varchar(255) [not null]
      egcs_cn_description_en text [not null]
      egcs_cn_description_fr text [not null]
      egcs_cn_bucketorcontainer varchar [not null] // Name of bucket for files (e.g. my-app-uploads)
      egcs_cn_objectkey varchar [not null] // ID for document (GCDocs) or S3 Key for fle (e.g. uploads/2026/03/document.pdf)
      egcs_cn_region varchar // Useful for S3 to specify the AWS region
      egcs_cn_mimetype text [not null] // mime type for file (e.g. application/pdf)
