      egcs_cn_name_en varchar(255) [not null] // Checklist name (en)
      egcs_cn_name_fr varchar(255) [not null] // Checklist name (fr)
      egcs_cn_schema jsonb [not null]
      _deleted boolean [not null, default: false]

      indexes {
        (egcs_cn_agency, egcs_cn_name_en, egcs_cn_version) [name: 'cn_idx_formschemaagencynameenversion', unique, where: `_deleted = false`]
        (egcs_cn_agency, egcs_cn_name_fr, egcs_cn_version) [name: 'cn_idx_formschemaagencynamefrversion', unique, where: `_deleted = false`]
      }
    }

