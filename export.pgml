      egcs_cn_name_fr varchar(255) [not null]
      egcs_cn_approvaltemplate bigint [not null]
      egcs_cn_status public.approval_status [not null]
      _deleted boolean [not null, default: false]

      Constraint cn_ref_routingslipentityidentitytype: foreign key (egcs_cn_entityid, egcs_cn_entitytype) references public.common_entity (id_egcs_cn_entitytype)
      indexes {
        (egcs_cn_entitytype, egcs_cn_entityid) [name: 'cn_idx_routingslipentitytypeentityid', unique, where: `_deleted = false AND egcs_cn_status IN ('draft' , 'pendingapproval' , 'approved')`]
      }
    }

    Table public.common_approval in Common {
      id bigserial [pk, not null] // System ID
      egcs_cn_sequence numeric [not null]
      egcs_cn_name_en varchar(255) [not null]
      egcs_cn_name_fr varchar(255) [not null]
      egcs_cn_routingslip bigint [not null]
      egcs_cn_defaultuser bigint [not null] // The user assigned from the approval template
      egcs_cn_assigneduser bigint // The user the approval is assigned to and the person that can action this approval
      egcs_cn_onbehalf bigint // Required if the default user != assigned user
      egcs_cn_approvalpositiontitle text
      egcs_cn_isadded boolean [not null]
      egcs_cn_approvalvalue boolean
      egcs_cn_approvaldate timestamptz
      egcs_cn_comment text
      egcs_cn_attachment bigint

      Constraint cn_chk_approvalapprovalvalueapprovalpositiontitlenull: NOT (egcs_cn_approvalpositiontitle IS NULL AND egcs_cn_approvalvalue IS NOT NULL)
      Constraint cn_chk_approvaldefaultuserassigneduseronbehalfnull: NOT (egcs_cn_defaultuser <> egcs_cn_assigneduser AND egcs_cn_onbehalf IS NULL)
      Constraint cn_chk_approvalassigneduseronbehalfapprovalpositiontitlenotnull: NOT (egcs_cn_defaultuser = egcs_cn_assigneduser AND egcs_cn_onbehalf IS NOT NULL)
      indexes {
        (egcs_cn_routingslip, egcs_cn_sequence) [name: 'cn_idx_approvalroutingslipsequence', unique]
      }
    }

