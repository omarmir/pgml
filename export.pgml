        egcs_cn_street1 varchar(255) [not null]
        egcs_cn_street2 varchar(255)
        egcs_cn_street3 varchar(255)
        _deleted boolean [not null, default: false]

        Constraint cn_chk_addressaddresscountryaddresssubdivision: ((egcs_cn_addresscountry = 'ca'::public.countries) AND ((egcs_cn_addresssubdivision)::text = ANY ((enum_range(NULL::public.jurisdiction))::text[]))) OR (egcs_cn_addresscountry <> 'ca'::public.countries)
      }

