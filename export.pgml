      egcs_cn_name_fr varchar(255) [not null] // Assessment name (fr)
      egcs_cn_outcomename_en varchar(255) [not null] // User facing name for the outcome (e.g. Mitigations)
      egcs_cn_outcomename_fr varchar(255) [not null] // User facing name for the outcome (e.g. Mitigations)
      egcs_cn_status public.statuses [not null]
      egcs_cn_version numeric(10, 2) [not null]
      egcs_cn_disablecustomoutcomes boolean [not null]
      egcs_cn_disablealignment boolean [not null]
      egcs_cn_disablereviewers boolean [not null]
      egcs_cn_scoringmatrix jsonb
      egcs_cn_assessmentschema jsonb
      egcs_cn_publishedscoringmatrix jsonb
      egcs_cn_publishedassessmentschema jsonb
      _deleted boolean [not null, default: false]

      Constraint cn_chk_reviewschemaentitytype: egcs_cn_entitytype NOT IN ('fundingopportunity', 'transferpaymentstream', 'commonreview', 'commonrecommendation')
      indexes {
        (id, egcs_cn_entitytype) [name: 'cn_idx_reviewschemaidentitytype', unique]
        (egcs_cn_agency, egcs_cn_name_en, egcs_cn_version) [name: 'cn_idx_reviewschemaagencynameenversion', unique, where: `_deleted = false`]
        (egcs_cn_agency, egcs_cn_name_fr, egcs_cn_version) [name: 'cn_idx_reviewschemaagencynamefrversion', unique, where: `_deleted = false`]
      }
    }

    Table public.common_review_set_setup in Common {
      id bigserial [pk, not null] // System ID
      egcs_cn_scopetype public.entity_type [not null] // fundingopportunity | transferpaymentstream | fundingcaseintake | fundingcaseagreement | applicantrecipient
      egcs_cn_scopeid bigint [not null] // Which specific TP Stream or FO owns this config
      egcs_cn_entitytype public.entity_type [not null] // What completion event triggers set creation
      egcs_cn_oncompletion boolean [not null] // Is this set generated automatically on completion?
      egcs_cn_name_en varchar(255) [not null]
      egcs_cn_name_fr varchar(255) [not null]
      egcs_cn_order smallint [not null]
      egcs_cn_sequential boolean [not null] // Are reviews created and completed sequentially?
      egcs_cn_approvaltemplate bigint
      egcs_cn_active boolean [not null]
      _deleted boolean [not null, default: false]

      Constraint cn_chk_reviewsetsetupentitytype: egcs_cn_entitytype NOT IN ('fundingopportunity', 'transferpaymentstream', 'commonreview', 'commonrecommendation')
      Constraint cn_chk_reviewsetsetupscopetype: egcs_cn_scopetype IN ('fundingopportunity', 'transferpaymentstream', 'fundingcaseintake', 'fundingcaseagreement', 'applicantrecipient')
      Constraint cn_ref_reviewsetsetupscopeidscopetype: foreign key (egcs_cn_scopeid, egcs_cn_scopetype) references public.common_entity (id_egcs_cn_entitytype)
      indexes {
        (egcs_cn_scopeid, egcs_cn_entitytype, egcs_cn_name_en) [name: 'cn_idx_reviewsetsetupscopeidentitytypenameen', unique, where: `_deleted = false AND egcs_cn_active = TRUE`]
        (egcs_cn_scopeid, egcs_cn_entitytype, egcs_cn_name_fr) [name: 'cn_idx_reviewsetsetupscopeidentitytypenamefr', unique, where: `_deleted = false AND egcs_cn_active = TRUE`]
        (egcs_cn_scopeid, egcs_cn_entitytype, egcs_cn_order) [name: 'cn_idx_reviewsetsetupscopeidentitytypeorder', unique, where: `_deleted = false AND egcs_cn_active = TRUE`]
        (id, egcs_cn_entitytype) [name: 'cn_idx_reviewsetsetupidentitytype', unique]
      }
    }

    Table public.common_review_setup in Common {
      id bigserial [pk, not null] // System ID
      egcs_cn_entitytype public.entity_type [not null] // Must match `egcs_cn_entitytype` of the parent `Common Review Set Setup` row. Exists solely to enable composite FK type enforcement — do not set independently.
      egcs_cn_order smallint [not null]
      egcs_cn_reviewset bigint [not null]
      egcs_cn_approvaltemplate bigint
      egcs_cn_reviewschema bigint [not null]
      _deleted boolean [not null, default: false]

      Constraint cn_ref_reviewsetupreviewschemaentitytype: foreign key (egcs_cn_reviewschema, egcs_cn_entitytype) references public.common_review_schema (id_egcs_cn_entitytype)
      Constraint cn_ref_reviewsetupreviewsetentitytype: foreign key (egcs_cn_reviewset, egcs_cn_entitytype) references public.common_review_set_setup (id_egcs_cn_entitytype)
      indexes {
        (egcs_cn_reviewset, egcs_cn_order) [name: 'cn_idx_reviewsetupreviewsetorder', unique, where: `_deleted = false`]
      }
    }

    Table public.common_review_set in Common {
      id bigserial [pk, not null] // System ID
      egcs_cn_status public.statuses [not null]
      egcs_cn_reviewsetsetup bigint [not null]
      egcs_cn_approvaltemplate bigint
      egcs_cn_entitytype public.entity_type [not null]
      egcs_cn_entityid bigint [not null]
      _deleted boolean [not null, default: false]

      Constraint cn_ref_reviewsetentityidentitytype: foreign key (egcs_cn_entityid, egcs_cn_entitytype) references public.common_entity (id_egcs_cn_entitytype)
      Constraint cn_ref_reviewsetreviewsetsetupentitytype: foreign key (egcs_cn_reviewsetsetup, egcs_cn_entitytype) references public.common_review_set_setup (id_egcs_cn_entitytype)
      indexes {
        (egcs_cn_reviewsetsetup, egcs_cn_entitytype, egcs_cn_entityid) [name: 'cn_idx_reviewsetreviewsetsetupentitytypeentityid', where: `_deleted = false AND egcs_cn_status NOT IN (complete, approved, denied, withdrawn, cancelled)`]
      }
    }

    Table public.common_review in Common {
      id bigint [pk, not null] // PK sourced from Common_Entity via trigger on insert.
      egcs_cn_helpers jsonb // key-value pairs
      egcs_cn_status public.statuses [not null]
      egcs_cn_disablecustomoutcomes boolean [not null]
      egcs_cn_disablealignment boolean [not null]
      egcs_cn_disablereviewers boolean [not null]
      egcs_cn_reviewalignment boolean
      egcs_cn_reviewalignmentnarrative text
      egcs_cn_reviewalignresult numeric(10, 2)
      egcs_cn_reviewresult numeric(10, 2) [not null]
      egcs_cn_reviewset bigint [not null]
      egcs_cn_reviewschema bigint [not null]
      egcs_cn_approvaltemplate bigint
      _deleted boolean [not null, default: false]

      Constraint cn_chk_reviewreviewresult: NOT (egcs_cn_reviewalignment = TRUE AND (egcs_cn_reviewalignmentnarrative IS NULL OR egcs_cn_reviewalignresult IS NULL))
      indexes {
        (egcs_cn_reviewset) [name: 'cn_idx_reviewreviewset']
      }
    }

